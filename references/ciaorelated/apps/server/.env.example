DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ciaorelated?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
HOST="0.0.0.0"
PORT="4000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
CLIENT_ORIGIN="http://localhost:3000"
CURRENT_TERMS_VERSION="1"
NOMINATIM_EMAIL=""

# Optional app administration. Use comma-separated usernames for multiple entries.
# Backend authorization remains authoritative; the mobile app only reflects these permissions.
# The first matching ADMIN_USERNAMES profile is also used as sender for automatic welcome messages.
# If this is empty, the first Profile with role ADMIN is used. If no admin exists, no welcome message is sent.
ADMIN_USERNAMES=""

# Optional remote app update configuration.
# The app asks this public config on startup and blocks outdated builds before login/onboarding.
# Generic values apply to every branded app instance that uses this server.
APP_IOS_MIN_SUPPORTED_VERSION=""
APP_IOS_LATEST_VERSION=""
APP_IOS_STORE_URL=""
APP_ANDROID_MIN_SUPPORTED_VERSION=""
APP_ANDROID_LATEST_VERSION=""
APP_ANDROID_STORE_URL=""

# Optional app-specific overrides use the public app slug in uppercase.
# Example for EXPO_PUBLIC_APP_SLUG=songverwandt:
# APP_SONGVERWANDT_IOS_MIN_SUPPORTED_VERSION="1.1.0"
# APP_SONGVERWANDT_IOS_LATEST_VERSION="1.1.0"
# APP_SONGVERWANDT_IOS_STORE_URL="https://apps.apple.com/app/id6751941066"
# APP_SONGVERWANDT_ANDROID_MIN_SUPPORTED_VERSION="1.1.0"
# APP_SONGVERWANDT_ANDROID_LATEST_VERSION="1.1.0"
# APP_SONGVERWANDT_ANDROID_STORE_URL="https://play.google.com/store/apps/details?id=com.dogankaraarslan1.songverwandt"

SENDGRID_API_KEY=""
EMAIL_FROM="ciaorelated <noreply@example.com>"

# Phone login / registration with Twilio Verify.
# If these are empty, development logs SMS codes to the server console.
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# S3-compatible object storage for media uploads.
# Works with AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO, etc.
S3_BUCKET=""
S3_REGION="eu-north-1"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE=""
SIGNED_URL_TTL_SECONDS="900"

# Legacy AWS-style names used by some helpers.
AWS_REGION="eu-north-1"
AWS_S3_BUCKET=""

# Upload limits.
MAX_AVATAR_BYTES="5242880"
MAX_UPLOAD_BYTES="104857600"
MAX_POST_IMAGE_BYTES="10485760"
MAX_POST_VIDEO_BYTES="104857600"
MAX_STORY_UPLOAD_BYTES="83886080"

# Optional background workers.
ENABLE_VIDEO_WORKER="false"
ENABLE_IMAGE_WORKER="false"
ENABLE_STORY_WORKER="false"
ENABLE_AVATAR_WORKER="false"
ENABLE_VLOG_COVER_WORKER="false"
ENABLE_DAILY_DIGEST="false"
# Separate from ranking; requires explicit database activation first.
ENABLE_COMMUNITY_INFLUENCE_WORKER="false"

# Optional worker tooling.
TMPDIR=""
FFMPEG_PATH="/usr/local/bin/ffmpeg"
FFPROBE_PATH="/usr/local/bin/ffprobe"
# Influence ranking is independent of accrual and off until explicitly enabled.
# Use a fixed UTC activation time, never a timestamp regenerated on restart.
ENABLE_COMMUNITY_INFLUENCE_RANKING=false
COMMUNITY_INFLUENCE_RANKING_STARTS_AT=
COMMUNITY_INFLUENCE_RANKING_MAX_AGE_HOURS=72
COMMUNITY_INFLUENCE_RANKING_HALF_LIFE_HOURS=24
COMMUNITY_INFLUENCE_RANKING_MAX_PROMOTION=12
COMMUNITY_INFLUENCE_RANKING_HALF_STRENGTH_POINTS=5000
