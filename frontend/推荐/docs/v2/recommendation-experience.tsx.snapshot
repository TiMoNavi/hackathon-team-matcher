"use client";
import { useEffect,useRef,useState,useSyncExternalStore } from 'react';
import { AnimatePresence,motion,useInView } from 'motion/react';
import { Dialog as Panel } from 'radix-ui';
import { ArrowDown,ArrowLeft,ArrowRight,ArrowUp,ArrowUpRight,Bookmark,Check,ChevronDown,ChevronLeft,Compass,FlaskConical,MapPin,MessageCircle,PanelRightClose,Pause,Play,RotateCcw,Sparkles,Sprout,Users,X } from 'lucide-react';
import { Brand } from '@/components/brand';
import { Button } from '@/components/ui/button';
import { Card,CardContent } from '@/components/ui/card';
import { Avatar,AvatarFallback,AvatarImage } from '@/components/ui/avatar';
import { Badge } from '@/components/ui/badge';
import { Input } from '@/components/ui/input';
import { Dialog,DialogContent,DialogDescription,DialogHeader,DialogTitle } from '@/components/ui/dialog';
import { TiltCard } from '@/components/effects/tilt-card';
import { GridBackground } from '@/components/effects/grid-background';
import { GradientFloor } from '@/components/effects/gradient-floor';
import { GradientText } from '@/components/effects/gradient-text';
import { FrostCloud } from '@/components/illustrations/frost-cloud';
import { ThinkingLoader } from '@/components/affect/thinking-loader-clean';
import { TextReveal } from '@/components/affect/text-reveal';
import { NumberTicker } from '@/components/affect/number-ticker';
import { MotionPreferenceProvider,SceneMotion,useMotionPreference } from '@/components/motion-preference';
import { HangingTags,ShowcaseBoard,ProjectArt } from '@/components/showcase-board';
import { ProfileDossier } from '@/components/profile-dossier';
import { SearchExperience } from '@/components/search-experience';
import { AssistantCompanion } from '@/components/assistant-companion';
import { people } from '@/lib/people';
import { type ShowcaseItem } from '@/lib/showcase';
import { cn } from '@/lib/utils';

function useMedia(query:string){return useSyncExternalStore((notify)=>{const m=matchMedia(query);m.addEventListener('change',notify);return()=>m.removeEventListener('change',notify);},()=>matchMedia(query).matches,()=>false);}
function subscribeVisibility(notify:()=>void){document.addEventListener('visibilitychange',notify);return()=>document.removeEventListener('visibilitychange',notify);}
type Message={role:'user'|'assistant';text:string};
type Detail={title:string;text:string;source:string;art?:ShowcaseItem['art']};
function Experience(){
  const [personIndex,setPersonIndex]=useState(0),[cardIndex,setCardIndex]=useState(0),[auto,setAuto]=useState(true);
  const [assistant,setAssistant]=useState(false),[detail,setDetail]=useState<Detail|null>(null),[eventOpen,setEventOpen]=useState(false);
  const [reading,setReading]=useState(false),[composing,setComposing]=useState(false),[input,setInput]=useState('');
  const [saved,setSaved]=useState<string[]>([]),[notice,setNotice]=useState(''),[messages,setMessages]=useState<Message[]>([]);
  const [searching,setSearching]=useState(true),[phase,setPhase]=useState(0),[run,setRun]=useState(0),[replying,setReplying]=useState(false);
  const {paused,reduced,toggle}=useMotionPreference();
  const narrow=useMedia('(max-width: 1099px)'),short=useMedia('(max-height: 780px) and (min-width: 768px)');
  const visible=useSyncExternalStore(subscribeVisibility,()=>!document.hidden,()=>true);
  const stageRef=useRef<HTMLElement>(null),detailsRef=useRef<HTMLDivElement>(null);
  const inView=useInView(stageRef,{amount:.2});
  const composerRef=useRef<HTMLInputElement>(null),panelInput=useRef<HTMLInputElement>(null),panelToggle=useRef<HTMLButtonElement>(null);
  const detailOrigin=useRef<HTMLElement|null>(null),replyTimer=useRef<ReturnType<typeof setTimeout>|null>(null);
  const searchTimers=useRef<ReturnType<typeof setTimeout>[]>([]),messageEnd=useRef<HTMLDivElement>(null);
  const person=people[personIndex],isSaved=saved.includes(person.id);
  const playing=auto&&!paused&&!reading&&!composing&&!assistant&&!detail&&!searching&&!eventOpen&&visible&&inView;
  useEffect(()=>{if(!playing)return;const t=setTimeout(()=>setCardIndex(i=>(i+1)%6),5600);return()=>clearTimeout(t);},[playing,cardIndex,personIndex]);
  useEffect(()=>{searchTimers.current=[1,2,3,4].map((step)=>setTimeout(()=>setPhase(step),step*720));searchTimers.current.push(setTimeout(()=>setSearching(false),3400));return()=>searchTimers.current.forEach(clearTimeout);},[run]);
  useEffect(()=>{if(!notice)return;const t=setTimeout(()=>setNotice(''),3000);return()=>clearTimeout(t);},[notice]);
  useEffect(()=>()=>{if(replyTimer.current)clearTimeout(replyTimer.current);},[]);
  useEffect(()=>{messageEnd.current?.scrollIntoView({behavior:reduced?'instant':'smooth',block:'nearest'});},[messages,replying,reduced]);
  function searchAgain(){if(searching)return;setSearching(true);setPhase(0);setCardIndex(0);setRun(v=>v+1);}
  function skipSearch(){searchTimers.current.forEach(clearTimeout);setPhase(4);setSearching(false);}
  function choosePerson(index:number){setPersonIndex((index+people.length)%people.length);setCardIndex(0);setReading(false);setDetail(null);}
  function openDetail(value:Detail,trigger?:HTMLElement){detailOrigin.current=trigger||document.activeElement as HTMLElement;setDetail(value);}
  function openProject(item:ShowcaseItem,trigger?:HTMLElement){openDetail({title:item.title,text:item.description,source:item.source,art:item.art},trigger);}
  function scrollDetails(){detailsRef.current?.scrollIntoView({behavior:reduced?'instant':'smooth',block:'start'});}
  function toggleSave(){setSaved(s=>isSaved?s.filter(id=>id!==person.id):[...s,person.id]);setNotice(isSaved?'已取消本次收藏':'已加入本次收藏，刷新后重置');}
  function sendPrompt(value=input){const prompt=value.trim();if(!prompt||replying)return;setAssistant(true);setInput('');setMessages(m=>[...m,{role:'user',text:prompt}]);setReplying(true);const reply=/设计|figma/i.test(prompt)?'可以先看看许知夏。TA 有从用户访谈到交互原型的经验，希望和开发伙伴一起把体验做细。你可以点「看看知夏」，让 TA 的作品来到前排。':/时间|协作|周末/.test(prompt)?person.name+'填写的活动时间是「'+person.chapters[2][0].title+'」。可以先聊你们都能投入的时段，再决定第一个小版本做多大。':person.name+'正在关注「'+person.chapters[0][2].title+'」。'+person.chapters[0][1].detail+'你可以从一个具体场景开始，看看彼此最想贡献什么。';replyTimer.current=setTimeout(()=>{setMessages(m=>[...m,{role:'assistant',text:reply}]);setReplying(false);},1050);}
  return <Panel.Root open={assistant} onOpenChange={setAssistant} modal={narrow}><div className="discovery-app v2-app" data-assistant={assistant} data-reduced={reduced} data-paused={paused} data-searching={searching}>
    <a href="#main" className="skip-link">跳到推荐内容</a><header className="app-header"><div className="glass-nav"><a className="brand-link" href="http://127.0.0.1:4200/" aria-label="同频首页"><Brand/></a><nav className="main-nav" aria-label="主导航"><a href="#main" aria-current="page"><Compass/>发现</a><button onClick={()=>setNotice('广场尚未接入此原型')}><Users/>广场</button><a href="http://127.0.0.1:4202/"><MessageCircle/>消息</a><button onClick={()=>setNotice('个人中心尚未接入此原型')}><Avatar className="nav-avatar"><AvatarImage src="/avatars/avatar-2.jpg" alt=""/><AvatarFallback>我</AvatarFallback></Avatar>个人</button></nav><div className="header-actions"><Button variant="ghost" className="global-motion" onClick={toggle} disabled={reduced} aria-label={paused?'开启页面动效':'暂停页面动效'} aria-pressed={paused}>{paused?<Play size={15}/>:<Pause size={15}/>}</Button><button className="event-switch" onClick={()=>setEventOpen(true)}><span className="event-dot"/>周末造物场<ChevronDown size={14}/></button></div></div></header>
    <div className="workspace"><main className="main-content" id="main"><div className="first-fold"><div className="context-line"><span><Compass size={14}/>发现<span className="slash">/</span>推荐给你的有趣灵魂</span><span className="prototype-label"><FlaskConical size={13}/>活动内推荐 · 交互演示</span></div><div className="page-heading"><div><h1>有些合拍，<GradientText colors={['var(--foreground)','var(--primary)','var(--primary)']} speed={10} sweep={false}>藏在这些小事里。</GradientText></h1><p>看看 TA 做过什么，最近在想什么，还有你们能一起做的事。</p></div><Button variant="outline" className="preference-button refresh-recommendations" onClick={searchAgain} disabled={searching}><RotateCcw size={15}/>{searching?'AI 搜索中':'AI 重新搜索'}<Sparkles size={14}/></Button></div>
      <section ref={stageRef} className="discovery-stage showcase-stage" aria-label="动态人物推荐" aria-busy={searching}><SceneMotion active={inView&&visible&&!paused}><div className="showcase-atmosphere" aria-hidden="true"><GridBackground size={56} speed={paused?0:18} reveal={false} color="color-mix(in srgb,var(--primary) 6%,transparent)"/><GradientFloor speed={paused?0:25} colors={['var(--secondary)','var(--muted)','var(--background)']}/></div></SceneMotion>
      <div className="showcase-content" inert={searching||undefined} aria-hidden={searching||undefined}><div className="person-column"><div className="person-deck"><div className="card-backing backing-one" aria-hidden="true"/><div className="card-backing backing-two" aria-hidden="true"/><AnimatePresence mode="wait" initial={false}><motion.div key={person.id} initial={{opacity:0,x:reduced?0:-30,rotate:reduced?0:-5}} animate={{opacity:1,x:0,rotate:0}} exit={{opacity:0,x:reduced?0:-24,rotate:reduced?0:3}} transition={{duration:reduced?0:.35}}><TiltCard maxTilt={paused?0:5} scale={1.015} glare={!paused} className="person-tilt"><Card className="person-card gap-0 py-0"><CardContent className="person-cover p-0"><span className="meet-label"><Sprout size={14}/>正在寻找同频的你</span><button className={cn('save-button',isSaved&&'is-saved')} onClick={toggleSave} aria-label={isSaved?'取消收藏':'收藏这个人'} aria-pressed={isSaved}><Bookmark size={18} fill={isSaved?'currentColor':'none'}/></button><div className="cover-orbit orbit-one"/><div className="cover-orbit orbit-two"/><span className="cover-spark"><Sparkles size={22}/></span></CardContent><CardContent className="person-body"><Avatar className="person-avatar"><AvatarImage src={person.image} alt={person.name+'的演示头像'}/><AvatarFallback>{person.name[0]}</AvatarFallback></Avatar><div className="person-name-line"><h2>{person.name}</h2><span className="english-name">{person.english}</span></div><p className="person-role">{person.role}</p><p className="person-intro">{person.intro}</p><div className="person-tags">{person.tags.map(tag=><Badge variant="secondary" key={tag}>{tag}</Badge>)}</div><div className="person-mini-facts"><span><MapPin size={13}/>{person.city}</span><span><Sparkles size={13}/>期待一起做作品</span></div><div className="person-looking"><small>这一次，想找</small><p>{person.looking}</p></div><Button variant="outline" className="profile-button" onClick={scrollDetails}>下翻，认识完整的 TA<ArrowDown size={15}/></Button></CardContent></Card></TiltCard></motion.div></AnimatePresence></div><p className="card-caption"><span/>一个人，六个可以展开的侧面</p></div>
      <div className="discovery-world"><HangingTags person={person} paused={paused||!inView} onOpen={(title,text,trigger)=>openDetail({title,text,source:'本人确认资料的演示'},trigger)}/><ShowcaseBoard key={person.id+run+String(searching)} person={person} index={cardIndex} onSelect={setCardIndex} onOpen={openProject} paused={paused||!playing} reduced={reduced} compact={short} onReading={setReading}/></div></div>
      <AnimatePresence>{searching&&<SearchExperience key={run} phase={phase} reduced={reduced} onCancel={skipSearch}/>}</AnimatePresence></section>
      <div className="browse-controls"><div className="people-selector"><span className="selector-label">还可以认识</span>{people.map((p,i)=><button key={p.id} onClick={()=>choosePerson(i)} aria-label={'查看'+p.name} aria-pressed={i===personIndex} disabled={searching}><Avatar><AvatarImage src={p.image} alt=""/><AvatarFallback>{p.name[0]}</AvatarFallback></Avatar><span>{p.name}</span>{i===personIndex&&<i className="selected-person-dot"/>}</button>)}</div><div className="playback-controls"><span className="deck-live-indicator"><i/>{searching?'正在找同频':playing?'正在翻看 TA 的世界':'停下来看看'}</span><Button variant="ghost" onClick={()=>setAuto(v=>!v)} disabled={reduced} aria-label={auto?'暂停卡片轮换':'继续卡片轮换'}>{auto?<Pause size={14}/>:<Play size={14}/>}<span>{auto?'暂停轮换':'继续轮换'}</span></Button><span className="control-divider"/><Button variant="ghost" className="arrow-button" aria-label="上一位" onClick={()=>choosePerson(personIndex-1)} disabled={searching}><ArrowLeft/></Button><span className="person-count"><NumberTicker value={personIndex+1} locale="en-US"/> / {people.length}</span><Button variant="ghost" className="arrow-button" aria-label="下一位" onClick={()=>choosePerson(personIndex+1)} disabled={searching}><ArrowRight/></Button></div></div><button className="scroll-dossier-cue" onClick={scrollDetails}>继续下翻，看看作品、经历和 AI 分析<ArrowDown size={14}/></button></div>
      <div ref={detailsRef} className="dossier-anchor"><ProfileDossier key={person.id} person={person} onOpen={openProject} onAsk={sendPrompt}/></div>
    </main></div>
    <div className="composer-dock"><div className="composer-hint"><Sparkles size={13}/>{searching?'搜索演示进行中，也可以先写下你的期待':'你的一句话，也许就是下一次相遇的起点'}</div><form className="composer" onSubmit={e=>{e.preventDefault();sendPrompt();}} onFocusCapture={()=>setComposing(true)} onBlurCapture={e=>{if(!e.currentTarget.contains(e.relatedTarget as Node))setComposing(false);}}><span className="composer-spark"><Sparkles size={21}/></span><label htmlFor="ai-prompt" className="sr-only">告诉 AI 你想找怎样的队友</label><Input id="ai-prompt" ref={composerRef} value={input} onChange={e=>setInput(e.target.value)} maxLength={600} placeholder="比如，想找一个周末一起做 AI 产品的搭档…" autoComplete="off"/><span className="composer-demo">演示</span><Button type="submit" className="send-button" aria-label="发送演示需求" disabled={!input.trim()||replying}><ArrowUp size={20}/></Button></form></div>
    <AssistantCompanion person={person} index={cardIndex} hidden={assistant||searching} paused={paused||!visible} onOpen={()=>setAssistant(true)}/>
    <Panel.Trigger asChild><button ref={panelToggle} className="ai-edge-handle" aria-label={assistant?'收起 AI 对话侧栏':'展开 AI 对话侧栏'}><ChevronLeft size={16}/><Sparkles size={15}/><span>AI</span></button></Panel.Trigger>
    <Panel.Portal>{narrow&&<Panel.Overlay className="assistant-overlay"/>}<Panel.Content className="assistant-panel v2-assistant-panel" aria-modal={narrow||undefined} onOpenAutoFocus={e=>{e.preventDefault();if(narrow)panelInput.current?.focus();}} onCloseAutoFocus={e=>{e.preventDefault();panelToggle.current?.focus();}} onInteractOutside={e=>{if(!narrow)e.preventDefault();}}><div className="assistant-header"><div><span className="assistant-mark"><Sparkles size={18}/></span><div><Panel.Title>一起找找灵感</Panel.Title><Panel.Description>当前活动内 · 预设助手演示</Panel.Description></div></div><Panel.Close asChild><Button variant="ghost" className="arrow-button" aria-label="关闭 AI 助手">{narrow?<X/>:<PanelRightClose/>}</Button></Panel.Close></div><div className="assistant-messages"><div className="assistant-welcome"><FrostCloud background={false} paused={paused} followPointer={!paused} className="panel-cloud"/><h3>有想法，<br/>我们就从这里聊。</h3><p>我可以陪你看看 TA 的作品，想想你们的交集，或者一起准备一句自然的开场。</p></div><div className="prompt-suggestions"><button onClick={()=>sendPrompt('找一位设计伙伴')} disabled={replying}><span>想认识一位设计伙伴</span><ArrowUpRight size={14}/></button><button onClick={()=>sendPrompt('我们在协作时间上合适吗？')} disabled={replying}><span>看看我们的协作节奏</span><ArrowUpRight size={14}/></button></div><div className="chat-messages" aria-live="polite" aria-relevant="additions">{messages.map((message,i)=><motion.div key={i} className={'chat-message '+message.role} initial={{opacity:0,y:reduced?0:10}} animate={{opacity:1,y:0}}><span className="message-author">{message.role==='user'?'你':'同频 · 演示回复'}</span>{message.role==='assistant'?<TextReveal as="p" text={message.text} by="char" stagger={8} duration={250}/>:<p>{message.text}</p>}</motion.div>)}{replying&&<ThinkingLoader phases={['整理这段演示资料','想一个可以开始的话题']} interval={500} size="sm"/>}</div>{messages.length>0&&!replying&&<div className="assistant-actions"><button onClick={()=>{choosePerson(1);if(narrow)setAssistant(false);}}>看看知夏<ArrowUpRight size={13}/></button><button onClick={()=>{setCardIndex(4);if(narrow)setAssistant(false);}}>把协作节奏带到前排<ArrowUpRight size={13}/></button></div>}<div ref={messageEnd}/></div><div className="panel-footer"><p><span className="tiny-dot"/>切换人物，仍保留这段对话</p><form onSubmit={e=>{e.preventDefault();sendPrompt();}}><label className="sr-only" htmlFor="panel-prompt">继续告诉助手你的想法</label><Input id="panel-prompt" ref={panelInput} value={input} onChange={e=>setInput(e.target.value)} maxLength={600} placeholder="接着说说你的想法…"/><Button type="submit" aria-label="发送侧栏演示需求" disabled={!input.trim()||replying}><ArrowUp size={17}/></Button></form><span className="panel-disclaimer">本地预写回复，不发送真实消息。</span></div></Panel.Content></Panel.Portal>
    <Dialog open={!!detail} onOpenChange={open=>{if(!open)setDetail(null);}}><DialogContent className="detail-dialog project-detail-dialog" showCloseButton={false} aria-modal="true" onCloseAutoFocus={e=>{e.preventDefault();detailOrigin.current?.focus();}}><DialogHeader><DialogTitle>{detail?.title}</DialogTitle><DialogDescription>{detail?.source}</DialogDescription></DialogHeader><Button variant="ghost" className="dialog-close" aria-label="关闭详情" onClick={()=>setDetail(null)}><X/></Button>{detail?.art&&<ProjectArt kind={detail.art}/>}<p className="detail-body">{detail?.text}</p><span className="source-line"><Check size={14}/>演示内容，不代表真实用户资料或能力评分</span><Button variant="secondary" onClick={()=>{const title=detail?.title;setDetail(null);sendPrompt('聊聊这个：'+title);}}>带着这个细节，问问 AI<Sparkles size={15}/></Button></DialogContent></Dialog>
    <Dialog open={eventOpen} onOpenChange={setEventOpen}><DialogContent showCloseButton={false}><DialogHeader><DialogTitle>当前活动</DialogTitle><DialogDescription>推荐只展示当前活动里的演示人物。</DialogDescription></DialogHeader><Button variant="secondary" className="event-choice" onClick={()=>setEventOpen(false)}><Sprout/>周末造物场<Check/></Button><Button variant="outline" onClick={()=>setEventOpen(false)}>继续发现</Button></DialogContent></Dialog><div className="toast-region" role="status"><AnimatePresence>{notice&&<motion.div className="notice-toast" initial={{opacity:0,y:10}} animate={{opacity:1,y:0}} exit={{opacity:0}}><Check size={15}/>{notice}</motion.div>}</AnimatePresence></div>
  </div></Panel.Root>;
}
export default function RecommendationExperience(){return <MotionPreferenceProvider><Experience/></MotionPreferenceProvider>;}
