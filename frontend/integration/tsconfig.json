{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../首页/*"],
      "cn": ["node_modules/cn/dist/index.d.ts"],
      "class-variance-authority": ["node_modules/class-variance-authority/dist/index.d.ts"],
      "radix-ui": ["node_modules/radix-ui/dist/index.d.ts"],
      "motion/react": ["node_modules/motion/dist/react.d.ts"],
      "lucide-react": ["node_modules/lucide-react/dist/lucide-react.d.ts"],
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom/*": ["node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts", "../首页/integration"]
}
